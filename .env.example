# --- G Office config — copy to .env and fill in (never commit .env) ---

# Claude / Anthropic key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Login for the dashboard — CHANGE THESE before going public
LOGIN_USER=changeme
LOGIN_PASS=use-a-strong-password

# Public address of THIS app (makes OAuth redirects + n8n callback correct)
PUBLIC_BASE_URL=https://iamceo.ai

# Your self-hosted n8n
N8N_BASE_URL=https://n8n.iamceo.ai

# Where the SQLite DB lives inside the container (matches the mounted volume)
AGENTS_DB=/app/data/agents.db
